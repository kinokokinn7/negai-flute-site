---
import '../styles/global.css';
import { site } from '../data/site.js';
import { sitePath } from '../lib/paths.js';
const { title = '', description = site.description } = Astro.props;
const href = (path = '') => sitePath(import.meta.env.BASE_URL, path);
const links = [{ label: '世界観', path: 'world/' }, { label: '登場人物', path: 'characters/' }, { label: '物語', path: 'story/' }];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title ? `${title} | ${site.title}` : `${site.title} | 物語の扉`}</title>
<meta name="description" content={description}/><meta name="theme-color" content="#f7f4eb"/>
<meta property="og:type" content="website"/><meta property="og:title" content={title ? `${title} | ${site.title}` : site.title}/><meta property="og:description" content={description}/><meta property="og:locale" content="ja_JP"/>
{canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}
<link rel="icon" type="image/svg+xml" href={href('favicon.svg')}/>
</head>
<body>
<a class="skip-link" href="#main">本文へ移動</a>
<header class="site-header"><a class="brand" href={href()} aria-label="ねがいのフルート トップ"><span class="brand-icon">✧</span><span>{site.title}<small>NEGAI NO FLUTE</small></span></a>
<nav aria-label="メインナビゲーション"><a class="home-link" href={href()} aria-current={Astro.url.pathname === href() ? 'page' : undefined}>はじめに</a>{links.map(link => <a href={href(link.path)} aria-current={Astro.url.pathname === href(link.path) ? 'page' : undefined}>{link.label}</a>)}</nav>
</header>
<main id="main"><slot/></main>
<footer class="site-footer"><div><a class="footer-title" href={href()}>{site.title}</a><p>{site.subtitle}</p></div><div class="footer-right"><a href={href('story/')}>物語への入口 <span aria-hidden="true">↗</span></a><small>© {new Date().getFullYear()} ねがいのフルート{site.authorName ? ` / ${site.authorName}` : ''}</small></div></footer>
</body>
</html>
