---
import Layout from '../layouts/Layout.astro';
import Scenery from '../components/Scenery.astro';
import CharacterCard from '../components/CharacterCard.astro';
import { site, characters, worlds } from '../data/site.js';
import { sitePath } from '../lib/paths.js';
const href = (path = '') => sitePath(import.meta.env.BASE_URL, path);
---
<Layout>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="tiny-line"></span> ORIGINAL FANTASY COMIC</p><h1>ねがいの<br/><span>フルート</span><i aria-hidden="true">✧</i></h1><p class="hero-tagline">月の向こうに、<br/>憧れた世界が待っていた。</p><p class="hero-description">フルートが大好きな少女ニーマロ。<br/>月夜の丘での出会いから、<br/>まだ知らない世界への冒険がはじまる。</p><a class="button" href={href('story/')}>物語の扉をひらく <span aria-hidden="true">↗</span></a><div class="hero-bottom"><span>SCROLL TO EXPLORE</span><span aria-hidden="true">↓</span></div></div><div class="hero-visual"><Scenery/><span class="vertical-caption" aria-hidden="true">その音色の先に、どんな世界が待っているだろう。</span></div></section>
<section class="intro-section"><div class="wrap intro-grid"><div><p class="eyebrow">ABOUT THE WORLD</p><h2>まだ知らない世界へ。<br/>物語を、少しだけ。</h2><a class="text-link" href={href('world/')}>世界観を知る <span aria-hidden="true">→</span></a></div><div class="world-list">{worlds.map(world => <article><span class="world-number">{world.number}</span><div><h3>{world.title}</h3><p>{world.description}</p></div><span class="world-star" aria-hidden="true">✧</span></article>)}</div></div></section>
<section class="wrap characters-section"><div class="section-heading"><div><p class="eyebrow">CHARACTERS</p><h2>物語を彩るひとたち。</h2></div><a class="text-link" href={href('characters/')}>登場人物を見る <span aria-hidden="true">→</span></a></div><div class="character-grid">{characters.map((character, index) => <CharacterCard character={character} index={index}/>)}</div></section>
<section class="wrap invitation"><div class="invitation-star" aria-hidden="true">✧</div><p class="eyebrow">OPEN THE STORY</p><h2>さあ、物語のはじまりへ。</h2><p>この世界をもっと知りたくなったら。<br/>まずは、物語の入口から。</p><a class="button button-light" href={href('story/')}>ストーリーを見る <span aria-hidden="true">↗</span></a></section>
</Layout>
